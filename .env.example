# Public production origin, without a trailing slash
NEXT_PUBLIC_SITE_URL=

# Stable owner key used by existing poems and projects
ADMIN_OWNER_ID=

# Keyed HMAC password verifier. Store the generated value as a hosted secret.
ADMIN_PASSWORD_HASH=

# Independent secret key for the password verifier
ADMIN_PASSWORD_PEPPER=

# Random HMAC secret for secure, HttpOnly admin sessions
ADMIN_SESSION_SECRET=
